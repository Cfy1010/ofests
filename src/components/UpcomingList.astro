---
import { getRelativeLocaleUrl } from "astro:i18n";
import { toLocale, useTranslations } from "../i18n";
import { formatDateRange, formatLocation, sortUpcomingEditions } from "../lib/editions.js";
import { availableCountries, availableMonths, genreKeys, genreOptions } from "../lib/filters.js";
import { festivalPath } from "../lib/festivals.js";
import UpcomingFilter from "./UpcomingFilter.jsx";

// editions : éditions à venir, telles que renvoyées par fetchUpcomingEditions()
// genres : tous les genres, de fetchGenres()
const { editions, genres } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

// Filtre par genre (#53) : options, puis pour chaque ligne les slugs qui la
// retiennent
const genreChoices = genreOptions(genres, editions, locale);

const rows = sortUpcomingEditions(editions).map((edition) => ({
	id: edition.id,
	name: edition.festivalName,
	href: getRelativeLocaleUrl(locale, festivalPath(edition.festivalSlug)),
	// Sans date : « Dates non annoncées · 2027 » (#4)
	dates:
		formatDateRange(edition.startDate, edition.endDate, locale) ??
		`${t("upcoming.datesNotAnnounced")} · ${edition.year}`,
	location: formatLocation(edition.city, edition.countryCode, locale),
	genre: edition.genreLabels[locale],
	countryCode: edition.countryCode,
	genreSlug: edition.genreSlug,
	genreKeys: genreKeys(edition, genreChoices),
	// Pour le filtre de période (#52)
	year: edition.year,
	startDate: edition.startDate,
	endDate: edition.endDate,
}));

// Filtres par pays (#51), par période (#52) et par genre (#53), ADR 0026 : libellés avec
// {count}, {range} et {month} laissés tels quels, remplis dans le navigateur
const countries = availableCountries(editions, locale);
const months = availableMonths(editions, new Date(), locale);
const count = "{count}";
const labels = {
	country: t("filter.country"),
	countrySelected: t("filter.countrySelected", { names: "{names}" }),
	countryMore: t("filter.countryMore", { names: "{names}", count }),
	resultsOne: t("filter.resultsOne", { count }),
	resultsOther: t("filter.resultsOther", { count }),
	noResults: t("filter.noResults"),
	reset: t("filter.reset"),
	genre: t("filter.genre"),
	genreSelected: t("filter.genreSelected", { names: "{names}" }),
	genreMore: t("filter.genreMore", { names: "{names}", count }),
	genreAllStyles: t("filter.genreAllStyles"),
	period: t("filter.period"),
	periodRange: t("filter.periodRange", { range: "{range}" }),
	periodFrom: t("filter.periodFrom", { month: "{month}" }),
	periodTo: t("filter.periodTo", { month: "{month}" }),
	periodStart: t("filter.periodStart"),
	periodEnd: t("filter.periodEnd"),
	anyMonth: t("filter.anyMonth"),
};
---

{
	rows.length === 0 ? (
		<p class="mt-6">{t("upcoming.empty")}</p>
	) : (
		// Toute liste énonce sa règle de tri (ADR 0004, 0019)
		<UpcomingFilter client:load rows={rows} countries={countries} genres={genreChoices} months={months} labels={labels} sortRule={t("upcoming.sortRule")} />
	)
}
