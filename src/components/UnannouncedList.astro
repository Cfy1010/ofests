---
import { getRelativeLocaleUrl } from "astro:i18n";
import { toLocale, useTranslations } from "../i18n";
import { festivalPath } from "../lib/festivals.js";

// festivals : résultat de selectFestivalsWithoutUpcoming(), déjà trié (#40)
const { festivals } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);

const rows = [];
for (const festival of festivals) {
	rows.push({
		name: festival.name,
		href: getRelativeLocaleUrl(locale, festivalPath(festival.slug)),
		country: festival.country,
	});
}
---

{
	rows.length > 0 && (
		<section class="mt-12">
			<h2 class="text-2xl font-bold text-heading">{t("upcoming.unannouncedTitle")}</h2>
			<ul class="mt-4">
				{rows.map((row) => (
					<li class="border-t border-line py-3 sm:grid sm:grid-cols-[2fr_1.5fr] sm:items-baseline sm:gap-4">
						<h3 class="text-lg font-bold">
							<a class="underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link" href={row.href}>
								{row.name}
							</a>
						</h3>
						{row.country && <p class="text-muted">{row.country}</p>}
					</li>
				))}
			</ul>
		</section>
	)
}
