---
import { Image } from "astro:assets";
import { toLocale, useTranslations } from "../i18n";
import { festivalSheetView } from "../lib/festivals.js";
import { findPoster } from "../lib/poster-images.js";

// sheet : fiche de fetchFestivalSheets() ; pageUrl : URL absolue de la page,
// reprise dans le JSON-LD
const { sheet, pageUrl } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const view = festivalSheetView(sheet, locale, pageUrl);
// Affiche de l'édition présentée seulement (#74, ADR 0030), jamais celle d'une autre
const poster = view.edition ? findPoster(sheet.festival.slug, view.edition.year) : undefined;
---

<article>
	<h1 class="text-3xl font-bold text-heading sm:text-4xl">{view.name}</h1>

	<dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
		<dt class="text-muted">{t("festival.genre")}</dt>
		<dd>{view.genre}</dd>
		{
			view.subgenres.length > 0 && (
				<>
					<dt class="text-muted">{t("festival.subgenres")}</dt>
					<dd>
						{/* Tags non filtrants (ADR 0017) : pas de lien */}
						<ul class="flex flex-wrap gap-2">
							{view.subgenres.map((subgenre) => (
								<li class="rounded border border-line px-2 text-sm text-muted">{subgenre}</li>
							))}
						</ul>
					</dd>
				</>
			)
		}
	</dl>

	{
		view.website && (
			<p class="mt-4">
				<a class="text-link underline" href={view.website}>
					{t("festival.website")}
				</a>
			</p>
		)
	}

	<section class="mt-8 border-t border-line pt-6">
		{view.editionKind !== "upcoming" && <p class="text-muted">{t("festival.nextEditionNotAnnounced")}</p>}
		{
			view.edition && (
				<>
					<h2 class:list={["text-xl font-bold", view.editionKind === "past" && "mt-4"]}>
						{view.editionKind === "upcoming"
							? t("festival.nextEdition", { year: view.edition.year })
							: t("festival.lastEdition", { year: view.edition.year })}
					</h2>
					<dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
						<dt class="text-muted">{t("festival.dates")}</dt>
						<dd>{view.edition.dates ?? t("upcoming.datesNotAnnounced")}</dd>
						<dt class="text-muted">{t("festival.place")}</dt>
						<dd>
							{view.edition.venue && <span class="block">{view.edition.venue}</span>}
							<span class="block">{view.edition.location}</span>
						</dd>
					</dl>
					{poster && (
						<figure class="mt-4 max-w-xs">
							<Image
								src={poster}
								alt={t("festival.posterAlt", { name: view.name, year: view.edition.year })}
								widths={[320, 480, 640]}
								sizes="(min-width: 352px) 320px, calc(100vw - 2rem)"
								format="webp"
								class="h-auto w-full rounded"
							/>
							<figcaption class="mt-2 text-sm text-muted">
								{t("festival.posterCredit", { name: view.name })}
							</figcaption>
						</figure>
					)}
				</>
			)
		}
	</section>

	{/* Traçabilité (ADR 0007) : sources et date de dernière révision */}
	<section class="mt-8 border-t border-line pt-6">
		<h2 class="text-xl font-bold">{t("festival.sources")}</h2>
		<ul class="mt-3 space-y-2">
			{
				view.sources.map((source) => (
					<li class="wrap-anywhere">
						<span class="text-muted">{t("festival.sourceKind", { kind: t(`source.kind.${source.kind}`) })} </span>
						<a class="text-link underline" href={source.url}>
							{source.label}
						</a>
						<span class="text-muted">, {t("festival.consultedOn", { date: source.consultedOn })}</span>
					</li>
				))
			}
		</ul>
		<p class="mt-6 text-sm text-muted">{t("festival.revisedOn", { date: view.revisedOn })}</p>
	</section>

	{/* Aucun bloc Event sans édition à venir datée (ADR 0012, 0023) */}
	{view.jsonLd && <script type="application/ld+json" set:html={view.jsonLd} />}
</article>
