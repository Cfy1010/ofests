---
import { Image } from "astro:assets";
import { toLocale, useTranslations } from "../i18n";
import { displayUrl, festivalSheetView } from "../lib/festivals.js";
import { findPoster } from "../lib/poster-images.js";

// sheet : fiche de fetchFestivalSheets() ; pageUrl : URL absolue de la page,
// reprise dans le JSON-LD
const { sheet, pageUrl } = Astro.props;

const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
const view = festivalSheetView(sheet, locale, pageUrl);
// Affiche de l'édition présentée seulement (#74, ADR 0030), jamais celle d'une autre
const poster = view.edition ? findPoster(sheet.festival.slug, view.edition.year) : undefined;
---

<article>
	<h1 class="text-3xl font-bold text-heading sm:text-4xl">{view.name}</h1>

	<dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
		<dt class="text-muted">{t("festival.genre")}</dt>
		<dd>{view.genre}</dd>
		{
			view.subgenres.length > 0 && (
				<>
					<dt class="text-muted">{t("festival.subgenres")}</dt>
					<dd>
						{/* Tags non filtrants (ADR 0017) : pas de lien */}
						<ul class="flex flex-wrap gap-2">
							{view.subgenres.map((subgenre) => (
								<li class="rounded border border-line px-2 text-sm text-muted">{subgenre}</li>
							))}
						</ul>
					</dd>
				</>
			)
		}
	</dl>

	{
		view.website && (
			<p class="mt-4">
				<a class="text-link underline" href={view.website}>
					{t("festival.website")}
				</a>
			</p>
		)
	}

	<section class="mt-8 border-t border-line pt-6">
		{view.editionKind !== "upcoming" && <p class="text-muted">{t("festival.nextEditionNotAnnounced")}</p>}
		{
			view.edition && (
				<>
					<h2 class:list={["text-xl font-bold", view.editionKind === "past" && "mt-4"]}>
						{view.editionKind === "upcoming"
							? t("festival.nextEdition", { year: view.edition.year })
							: t("festival.lastEdition", { year: view.edition.year })}
					</h2>
					<dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
						<dt class="text-muted">{t("festival.dates")}</dt>
						<dd>{view.edition.dates ?? t("upcoming.datesNotAnnounced")}</dd>
						<dt class="text-muted">{t("festival.place")}</dt>
						<dd>
							{view.edition.venue && <span class="block">{view.edition.venue}</span>}
							<span class="block">{view.edition.location}</span>
						</dd>
					</dl>
					{poster && (
						<>
						<figure class="mt-4 max-w-xs">
							{/* Lien vers le fichier d'origine (WebP 1080 px, nom empreinté), pas une taille générée */}
							<a
								href={poster.src}
								data-poster-link
								class="block text-link focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link"
							>
								<Image
									src={poster}
									alt={t("festival.posterAlt", { name: view.name, year: view.edition.year })}
									widths={[320, 480, 640]}
									sizes="(min-width: 352px) 320px, calc(100vw - 2rem)"
									format="webp"
									class="h-auto w-full rounded"
								/>
								<span class="mt-2 block text-sm underline">{t("festival.posterFullSize")}</span>
							</a>
							<figcaption class="mt-2 text-sm text-muted">
								{t("festival.posterCredit", { name: view.name })}
							</figcaption>
						</figure>
						{/* Visionneuse (#101) : même fichier que le lien ci-dessus, ouverte par le script en bas ; sans JavaScript, le lien suffit */}
						<dialog
							data-poster-dialog
							aria-label={t("festival.posterAlt", { name: view.name, year: view.edition.year })}
							class="m-auto w-fit max-w-[calc(100vw-2rem)] border border-line bg-page p-0 text-body backdrop:bg-black/80"
						>
							<div class="flex flex-col items-end gap-3 p-4">
								<button
									type="button"
									data-poster-close
									class="min-h-11 min-w-11 rounded border border-line px-4 py-2 text-link focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-link"
								>
									{t("festival.posterClose")}
								</button>
								<img
									src={poster.src}
									width={poster.width}
									height={poster.height}
									alt={t("festival.posterAlt", { name: view.name, year: view.edition.year })}
									loading="lazy"
									class="h-auto max-h-[80vh] w-auto max-w-full object-contain"
								/>
							</div>
						</dialog>
						</>
					)}
				</>
			)
		}
	</section>

	{/* Infos pratiques (#46, ADR 0033) : édition à venir seulement, valeur ou « Non précisé » */}
	{
		view.practical && (
			<section class="mt-8 border-t border-line pt-6">
				<h2 class="text-xl font-bold">{t("festival.practical")}</h2>
				<dl class="mt-3 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2">
					<dt class="text-muted">{t("festival.price")}</dt>
					<dd>
						{view.practical.priceKind === "from" && view.practical.price
							? t("festival.priceFrom", { price: view.practical.price })
							: view.practical.priceKind === "free"
								? t("festival.priceFree")
								: t("festival.practical.unspecified")}
					</dd>
					<dt class="text-muted">{t("festival.camping")}</dt>
					<dd>{t(`festival.practical.${view.practical.camping}`)}</dd>
					<dt class="text-muted">{t("festival.accessibility")}</dt>
					<dd>{t(`festival.practical.${view.practical.accessibility}`)}</dd>
				</dl>
				{view.practical.source && (
					<p class="mt-3 wrap-anywhere">
						<span class="text-muted">{t("festival.practicalSource")} </span>
						<a class="text-link underline" href={view.practical.source.url}>
							{displayUrl(view.practical.source.url)}
						</a>
						<span class="text-muted">, {t("festival.consultedOn", { date: view.practical.source.consultedOn })}</span>
					</p>
				)}
			</section>
		)
	}

	{/* Traçabilité (ADR 0007) : sources et date de dernière révision */}
	<section class="mt-8 border-t border-line pt-6">
		<h2 class="text-xl font-bold">{t("festival.sources")}</h2>
		<ul class="mt-3 space-y-2">
			{
				view.sources.map((source) => (
					<li class="wrap-anywhere">
						<span class="text-muted">{t("festival.sourceKind", { kind: t(`source.kind.${source.kind}`) })} </span>
						<a class="text-link underline" href={source.url}>
							{source.label}
						</a>
						<span class="text-muted">, {t("festival.consultedOn", { date: source.consultedOn })}</span>
					</li>
				))
			}
		</ul>
		<p class="mt-6 text-sm text-muted">{t("festival.revisedOn", { date: view.revisedOn })}</p>
	</section>

	{/* Aucun bloc Event sans édition à venir datée (ADR 0012, 0023) */}
	{view.jsonLd && <script type="application/ld+json" set:html={view.jsonLd} />}
</article>

<script>
	// Visionneuse du visuel (#101). Sans JavaScript, le lien mène au fichier.
	const link = document.querySelector("a[data-poster-link]");
	const dialog = document.querySelector("dialog[data-poster-dialog]");
	if (link instanceof HTMLAnchorElement && dialog instanceof HTMLDialogElement) {
		link.addEventListener("click", (event) => {
			// Ctrl, Maj, Alt, Cmd ou clic du milieu : le navigateur ouvre le fichier
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			// Écran tactile (pointeur grossier) : le pincement zoomerait toute la
			// page, pas le visuel, dans la visionneuse. Le navigateur ouvre donc
			// le fichier, où le pincement zoome l'image.
			if (window.matchMedia("(pointer: coarse)").matches) return;
			event.preventDefault();
			dialog.showModal();
		});
		dialog.querySelector("[data-poster-close]")?.addEventListener("click", () => dialog.close());
		// Clic sur le fond : la cible est le dialogue lui-même (son contenu le remplit)
		dialog.addEventListener("click", (event) => {
			if (event.target === dialog) dialog.close();
		});
		// Échap, bouton ou fond : le focus revient au lien
		dialog.addEventListener("close", () => link.focus());
	}
</script>
