---
import "../styles/global.css";
import { i18n } from "astro:config/client";
import { getAbsoluteLocaleUrl, getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "../i18n";

// path : chemin de la page sans préfixe de langue ("festivals").
// Il est le même dans les deux langues et sert aux liens hreflang.
const { title, description, path = "" } = Astro.props;

const locale = Astro.currentLocale;
const t = useTranslations(locale);

// x-default : l'anglais, pour les visiteurs ni francophones ni anglophones
const xDefaultLocale = "en";
const otherLocales = i18n.locales.filter((other) => other !== locale);
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — {t("site.name")}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={getAbsoluteLocaleUrl(locale, path)} />
		{
			i18n.locales.map((alternate) => (
				<link rel="alternate" hreflang={alternate} href={getAbsoluteLocaleUrl(alternate, path)} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(xDefaultLocale, path)} />
	</head>
	<body class="bg-ink text-cream">
		<header class="flex justify-end px-4 py-3">
			{
				otherLocales.map((other) => (
					<a
						class="py-2 text-sm text-ember underline"
						href={getRelativeLocaleUrl(other, path)}
						lang={other}
						hreflang={other}
					>
						{useTranslations(other)("language.name")}
					</a>
				))
			}
		</header>
		<slot />
	</body>
</html>
